# =====================================================================
# منصة قطاعات محافظة الرس — متغيرات البيئة
# انسخ الملف إلى .env.local ثم املأ القيم.
# .env.local لا يُرفع إلى Git أبدًا.
# =====================================================================

# --- Supabase (إلزامي للاختبارات/الشهادات/لوحة الإدارة) ---------------
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role: سري تمامًا — سيرفر فقط، لا يُعرّض للعميل
SUPABASE_SERVICE_ROLE_KEY=

# --- عنوان الموقع (يُستخدم في روابط التحقق داخل QR) -------------------
# محليًا: http://localhost:3000 — على Cloudflare: رابط الموقع الفعلي (*.freebuff.page)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Cloudflare Turnstile (اختياري في التطوير، إلزامي في الإنتاج) -----
# إذا لم تُضبط، يتخطى السيرفر التحقق (تحذير في السجلات).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Discord (المرحلة 12) --------------------------------------------
# Public Key من Discord Developer Portal → General Information.
# إن لم يُضبط، يرد /api/discord/webhook بالرمز 503 ولا يُسجّل أي حدث.
DISCORD_PUBLIC_KEY=

# --- Sentry (اختياري) -------------------------------------------------
# بلا DSN لا يُرسل أي شيء، والبناء يعمل عاديًا.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_AUTH_TOKEN=
