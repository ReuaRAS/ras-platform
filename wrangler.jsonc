// إعداد Workers للنشر من مستودع GitHub (حساب Cloudflare الخاص بالمشروع).
// الكاش التدريجي (ISR) يعمل عبر KV: الربط NEXT_INC_CACHE_KV أدناه.
// إن أردت لاحقًا الكاش على R2 مع Durable Objects (tag cache/queue) راجع README.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ras-sectors",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // كاش ISR لصفحات القطاعات (revalidate = 300) — يمنع إعادة التصيير لكل طلب
  "kv_namespaces": [
    { "binding": "NEXT_INC_CACHE_KV", "id": "c9e55c6f7d8f46e5bb1cddcff01055ae" }
  ],
  "observability": {
    "enabled": true
  }
}
