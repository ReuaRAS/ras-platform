// إعداد Workers للنشر من مستودع GitHub (حساب Cloudflare الخاص بالمشروع).
// الكاش المتقدّم (R2 + Durable Objects) يحتاج تفعيل R2 من لوحة Cloudflare؛
// بعد تفعيله أضف الربطات الموضّحة في README لتشغيل ISR.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ras-sectors",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
